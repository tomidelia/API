spring.application.name=demo
server.port=4002

# ---------------------------------------------------------------------------
# Conexion a la base de datos
# El esquema "ecommerce" hay que crearlo una sola vez desde MySQL Workbench.
# IMPORTANTE: poner abajo la password de TU MySQL antes de levantar el proyecto.
# ---------------------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/ecommerce
spring.datasource.driverClassName=com.mysql.cj.jdbc.Driver
spring.datasource.username=root
spring.datasource.password=CAMBIAR_POR_TU_PASSWORD

# Hibernate crea y actualiza las tablas a partir de las entidades.
spring.jpa.hibernate.ddl-auto=update

# Muestra en consola el SQL que genera el ORM (util para mostrar en clase).
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Fechas en formato ISO (2026-08-24T18:30:00) en lugar de timestamp numerico.
spring.jackson.serialization.write-dates-as-timestamps=false

# ---------------------------------------------------------------------------
# Seguridad (JWT)
# La clave y la expiracion se inyectan en JwtService con @Value, para no dejar
# datos sensibles escritos adentro del codigo.
# La expiracion esta en milisegundos: 86400000 = 24 horas.
# ---------------------------------------------------------------------------
application.security.jwt.secretKey=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
application.security.jwt.expiration=86400000

# ---------------------------------------------------------------------------
# Cuenta de la tienda (ADMIN)
# Se crea sola la primera vez que arranca, si todavia no existe. Hace falta
# porque el registro publico siempre da rol USER: sin esta cuenta nadie podria
# cargar el primer producto.
# ---------------------------------------------------------------------------
app.admin.email=admin@juegosdemesa.com
app.admin.password=admin1234

# Catalogo de ejemplo para desarrollo. Apagado: para la demo se crea todo desde
# Insomnia, como pidio la profesora.
app.seed-demo-data=false
